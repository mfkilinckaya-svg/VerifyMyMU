message: "If you use VerifyMyMU, please cite it using this metadata and the accompanying paper."
type: software
title: "VerifyMyMU: nine top-down measurement-uncertainty models for medical laboratories in one offline HTML file"
version: "1.0.0"
date-released: "2026-10-04"
license: MIT
repository-code: "https://github.com/mfkilinckaya-svg/VerifyMyMU"
doi: "10.5281/zenodo.<RECORD>"
authors:
  - family-names: Kilinckaya
    given-names: Muhammed Fevzi
    orcid: "https://orcid.org/0000-0002-0815-5467"
